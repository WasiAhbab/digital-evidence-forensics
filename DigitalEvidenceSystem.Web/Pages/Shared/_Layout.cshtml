<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta name="theme-color" content="#07162f"/><title>@ViewData["Title"] · TraceLock</title><link rel="stylesheet" href="~/css/site.css"/></head><body>
@if (User.Identity?.IsAuthenticated == true) {
<aside class="sidebar"><a class="brand" asp-page="/Index"><span class="shield">✦</span><span><b>TRACELOCK</b><small>Digital Evidence System</small></span></a><nav><a asp-page="/Index" class="@(ViewContext.RouteData.Values["page"]?.ToString()=="/Index"?"active":"")">⌂ <span>Dashboard</span></a><a asp-page="/Cases/Index">▤ <span>Cases</span></a><a asp-page="/Evidence/Index">▣ <span>Evidence</span></a><a asp-page="/Custody/Index">⇄ <span>Chain of Custody</span></a><a asp-page="/Analysis/Index">⌕ <span>Forensic Analysis</span></a><a asp-page="/Reports/Index">▥ <span>Reports</span></a><a asp-page="/Audit/Index">⌁ <span>Audit Logs</span></a><a asp-page="/Notifications/Index">◉ <span>Notifications</span></a>@if(User.IsInRole("Administrator")){<a asp-page="/Users/Index">♙ <span>Users</span></a>}<a asp-page="/Settings/Index">⚙ <span>Settings</span></a></nav><div class="sidebar-bottom"><div class="profile"><div class="avatar">@(User.Identity.Name?.FirstOrDefault())</div><span><b>@User.Identity.Name</b><small>@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</small></span></div><form method="post" asp-page="/Account/Logout"><button class="logout">⇥ Sign out</button></form></div></aside> }
<main class="@(User.Identity?.IsAuthenticated == true ? "workspace" : "auth-workspace")">@RenderBody()</main><script>document.querySelectorAll('form').forEach(f=>f.addEventListener('submit',()=>{const b=f.querySelector('button[type="submit"]:not(.table-action)');if(b){b.disabled=true;b.dataset.original=b.innerHTML;b.innerHTML='Working…';setTimeout(()=>{b.disabled=false;b.innerHTML=b.dataset.original},4000)}}));</script></body></html>
