@page "{id:int}"
@model DigitalEvidenceSystem.Web.Pages.Evidence.EditModel
@{ViewData["Title"]="Edit evidence";}
<header class="page-head"><div><span class="eyebrow">EVIDENCE REGISTER</span><h1>Edit @Model.Item.EvidenceNumber</h1><p>Maintain current metadata without altering the historical custody trail.</p></div><div class="head-actions"><a class="secondary link-button" asp-page="Index">Back</a><a class="secondary link-button" asp-page="/Files/Index" asp-route-evidenceId="@Model.Item.Id">Files</a><a class="primary link-button" asp-page="Integrity" asp-route-id="@Model.Item.Id">Verify integrity</a></div></header>
<form method="post" class="panel form-panel"><input asp-for="Item.Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><label>Evidence number<input asp-for="Item.EvidenceNumber" readonly/></label><label>Evidence name<input asp-for="Item.Name"/></label><label>Type<select asp-for="Item.Type"><option>Mobile phone</option><option>Computer</option><option>Hard drive</option><option>USB drive</option><option>Memory card</option><option>Image</option><option>Video</option><option>Audio</option><option>Document</option><option>Network capture</option><option>Other</option></select></label><label>Case<select asp-for="Item.CaseFileId"><option value="">Unassigned</option>@foreach(var c in Model.Cases){<option value="@c.Id">@c.CaseNumber — @c.Title</option>}</select></label><label>Source / device<input asp-for="Item.SourceDevice"/></label><label>Associated person<input asp-for="Item.AssociatedPerson"/></label><label>Collected on<input asp-for="Item.CollectedOn" type="datetime-local"/></label><label>Collection location<input asp-for="Item.CollectionLocation"/></label><label>Collector<input asp-for="Item.Collector"/></label><label>Current custodian<input asp-for="Item.CurrentCustodian"/></label><label>Storage location<input asp-for="Item.StorageLocation"/></label><label>Status<select asp-for="Item.Status"><option>Received</option><option>In Examination</option><option>Reviewed</option><option>Released</option></select></label><label class="wide-label">Description<textarea asp-for="Item.Description" rows="4"></textarea></label><label class="wide-label">Notes<textarea asp-for="Item.Notes" rows="4"></textarea></label></div><div class="integrity-inline"><span>SHA-256</span><code>@(string.IsNullOrWhiteSpace(Model.Item.HashSha256)?"Not generated":Model.Item.HashSha256)</code><span class="integrity-badge @Model.Item.IntegrityStatus.ToLower().Replace(" ","-")">@Model.Item.IntegrityStatus</span></div><button class="primary">Save changes →</button></form>
