@page
@model DigitalEvidenceSystem.Web.Pages.Evidence.CreateModel
@{
    ViewData["Title"] = "Add evidence";
}

<header class="page-head">
    <div>
        <span class="eyebrow">EVIDENCE REGISTER</span>
        <h1>Add evidence</h1>
        <p>Capture collection details now so the chain of custody starts with a complete record.</p>
    </div>
    <a class="secondary link-button" asp-page="Index">Cancel</a>
</header>

<form method="post" class="panel form-panel">
    <div asp-validation-summary="ModelOnly" class="validation"></div>

    <div class="form-grid">
        <label>
            Evidence number
            <input asp-for="Item.EvidenceNumber" placeholder="EV-004" />
        </label>

        <label>
            Evidence name
            <input asp-for="Item.Name" placeholder="e.g. Seized workstation" />
        </label>

        <label>
            Type
            <select asp-for="Item.Type">
                <option>Mobile phone</option>
                <option>Computer</option>
                <option>Hard drive</option>
                <option>USB drive</option>
                <option>Memory card</option>
                <option>Image</option>
                <option>Video</option>
                <option>Audio</option>
                <option>Document</option>
                <option>Network capture</option>
                <option>Other</option>
            </select>
        </label>

        <label>
            Case
            <select asp-for="Item.CaseFileId">
                <option value="">Unassigned</option>
                @foreach (var c in Model.Cases)
                {
                    <option value="@c.Id">@c.CaseNumber — @c.Title</option>
                }
            </select>
        </label>

        <label>
            Source / device
            <input asp-for="Item.SourceDevice" placeholder="Device model, serial or source" />
        </label>

        <label>
            Associated person
            <input asp-for="Item.AssociatedPerson" placeholder="Owner / suspect / victim" />
        </label>

        <label>
            Collection date/time
            <input asp-for="Item.CollectedOn" type="datetime-local" step="1" />
        </label>

        <label>
            Collection location
            <input asp-for="Item.CollectionLocation" placeholder="Scene / office / address" />
        </label>

        <label>
            Collector
            <input asp-for="Item.Collector" value="@User.Identity?.Name" />
        </label>

        <label>
            Current custodian
            <input asp-for="Item.CurrentCustodian" value="@User.Identity?.Name" />
        </label>

        <label>
            Storage location
            <input asp-for="Item.StorageLocation" placeholder="Locker C-01 / Digital Vault" />
        </label>

        <label>
            Status
            <select asp-for="Item.Status">
                <option>Received</option>
                <option>In Examination</option>
                <option>Reviewed</option>
                <option>Released</option>
            </select>
        </label>

        <label class="wide-label">
            Description
            <textarea asp-for="Item.Description" rows="4"></textarea>
        </label>

        <label class="wide-label">
            Notes
            <textarea asp-for="Item.Notes" rows="4"></textarea>
        </label>
    </div>

    <button class="primary" type="submit">Save evidence →</button>
</form>