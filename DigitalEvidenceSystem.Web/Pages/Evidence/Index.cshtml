@page
@model DigitalEvidenceSystem.Web.Pages.Evidence.IndexModel
@{ViewData["Title"]="Evidence";}
<header class="page-head"><div><span class="eyebrow">EVIDENCE REGISTER</span><h1>Evidence</h1><p>Track every item from intake through examination, integrity verification and release.</p></div><a class="primary link-button" asp-page="Create">+ Add evidence</a></header>
<form class="toolbar" method="get"><input name="q" value="@Model.Query" placeholder="Search evidence, device, custodian..."/><select name="status"><option value="">All statuses</option>@foreach(var s in Model.Statuses){<option selected="@(Model.Status==s)" value="@s">@s</option>}</select><select name="type"><option value="">All types</option>@foreach(var t in Model.Types){<option selected="@(Model.Type==t)" value="@t">@t</option>}</select><button class="secondary">Filter</button></form>
<section class="panel table-panel"><table><thead><tr><th>Evidence</th><th>Type / case</th><th>Custodian</th><th>Storage</th><th>Integrity</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><b>@item.EvidenceNumber</b><small>@item.Name</small></td><td>@item.Type<small>@(item.CaseFile?.CaseNumber??"Unassigned")</small></td><td>@(string.IsNullOrWhiteSpace(item.CurrentCustodian)?"—":item.CurrentCustodian)</td><td>@item.StorageLocation</td><td><span class="integrity-badge @item.IntegrityStatus.ToLower().Replace(" ","-")">@item.IntegrityStatus</span></td><td><span class="badge">@item.Status</span></td><td class="action-stack"><a class="text-link" asp-page="Edit" asp-route-id="@item.Id">Edit</a><a class="table-action" asp-page="/Files/Index" asp-route-evidenceId="@item.Id">Files</a><a class="table-action" asp-page="Integrity" asp-route-id="@item.Id">Verify</a></td></tr>}</tbody></table>@if(!Model.Items.Any()){<p class="empty">No evidence matches this filter.</p>}</section>
