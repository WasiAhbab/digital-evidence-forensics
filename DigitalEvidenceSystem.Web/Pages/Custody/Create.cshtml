@page
@model DigitalEvidenceSystem.Web.Pages.Custody.CreateModel
@{ViewData["Title"]="Record transfer";}
<header class="page-head"><div><span class="eyebrow">AUDITABLE TRANSFERS</span><h1>Record a transfer</h1><p>Create a permanent handover record. Historical custody entries cannot be edited or deleted.</p></div><a class="secondary link-button" asp-page="Index">Cancel</a></header>
<form method="post" class="panel form-panel"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><label>Evidence<select asp-for="Item.EvidenceItemId"><option value="">Select evidence</option>@foreach(var e in Model.Evidence){<option value="@e.Id">@e.EvidenceNumber — @e.Name</option>}</select></label><label>Transferred at<input asp-for="Item.TransferredAt" type="datetime-local"/></label><label>From<input asp-for="Item.FromPerson" placeholder="Current custodian"/></label><label>To<input asp-for="Item.ToPerson" placeholder="Receiving custodian / analyst"/></label><label>Location<input asp-for="Item.Location" placeholder="Evidence room / lab"/></label><label>Condition<select asp-for="Item.Condition"><option>Sealed / intact</option><option>Seal intact</option><option>Damaged packaging</option><option>Opened for examination</option><option>Other</option></select></label><label>Authorization<input asp-for="Item.Authorization" placeholder="Authorization / reference number"/></label><label>Reason / purpose<input asp-for="Item.Purpose" placeholder="Examination and imaging"/></label><label class="wide-label">Notes<textarea asp-for="Item.Notes" rows="4"></textarea></label></div><button class="primary">Record transfer →</button></form>
