@page
@model DigitalEvidenceSystem.Web.Pages.Files.IndexModel
@{ViewData["Title"]="Evidence files";}
<header class="page-head"><div><span class="eyebrow">SECURE FILE REFERENCE</span><h1>@Model.Evidence?.EvidenceNumber files</h1><p>@Model.Evidence?.Name · Files stay outside the SQL database and are tracked by metadata and SHA-256.</p></div><a class="secondary link-button" asp-page="/Evidence/Edit" asp-route-id="@Model.Evidence?.Id">Back to evidence</a></header>
<section class="panel upload-panel"><form method="post" enctype="multipart/form-data"><input type="hidden" asp-for="EvidenceId"/><label class="file-drop"><strong>Attach a forensic file</strong><span>PDF, image, video, audio, document, CSV, TXT or ZIP · up to 50 MB</span><input asp-for="Upload" type="file"/></label><div asp-validation-summary="ModelOnly" class="validation"></div><button class="primary">Upload and generate SHA-256 →</button></form></section>
<section class="panel table-panel"><table><thead><tr><th>File</th><th>Size</th><th>SHA-256</th><th>Uploaded</th><th></th></tr></thead><tbody>@foreach(var f in Model.Items){<tr><td><b>@f.FileName</b><small>@f.ContentType</small></td><td>@((f.SizeBytes/1024.0/1024.0).ToString("0.00")) MB</td><td><code class="hash">@f.Sha256</code></td><td>@f.UploadedAt.ToString("dd MMM yyyy, HH:mm")<small>@f.UploadedBy</small></td><td><a class="text-link" asp-page-handler="Download" asp-route-id="@f.Id">Download</a></td></tr>}</tbody></table>@if(!Model.Items.Any()){<p class="empty">No files are attached to this evidence item.</p>}</section>
