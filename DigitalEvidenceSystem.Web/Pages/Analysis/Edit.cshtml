@page "{id:int}"
@model DigitalEvidenceSystem.Web.Pages.Analysis.EditModel
@{ViewData["Title"]="Analysis record";}
<header class="page-head"><div><span class="eyebrow">FORENSIC WORKBENCH</span><h1>Analysis #@Model.Item.Id</h1><p>Record examination methods, findings and final references.</p></div><a class="secondary link-button" asp-page="Index">Back</a></header>
<form method="post" class="panel form-panel"><input asp-for="Item.Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><label>Analyst<input asp-for="Item.Analyst"/></label><label>Status<select asp-for="Item.Status"><option>Pending</option><option>In Progress</option><option>Completed</option><option>Reviewed</option></select></label><label>Tools / software<input asp-for="Item.ToolsUsed"/></label><label>Report reference<input asp-for="Item.ReportReference" placeholder="reports/CF-2026-001/analysis-01.pdf"/></label><label class="wide-label">Findings<textarea asp-for="Item.Findings" rows="7" placeholder="Document material findings, artifacts and conclusions..."></textarea></label><label class="wide-label">Notes<textarea asp-for="Item.Notes" rows="5"></textarea></label></div><button class="primary">Save analysis →</button></form>
