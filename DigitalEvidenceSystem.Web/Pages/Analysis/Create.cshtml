@page
@model DigitalEvidenceSystem.Web.Pages.Analysis.CreateModel
@{ViewData["Title"]="Start analysis";}
<header class="page-head"><div><span class="eyebrow">FORENSIC WORKBENCH</span><h1>Start analysis</h1><p>Create an examination record for assigned digital evidence.</p></div><a class="secondary link-button" asp-page="Index">Cancel</a></header>
<form method="post" class="panel form-panel"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><label>Evidence<select asp-for="Item.EvidenceItemId"><option value="">Select evidence</option>@foreach(var e in Model.Evidence){<option value="@e.Id">@e.EvidenceNumber — @e.Name</option>}</select></label><label>Status<select asp-for="Item.Status"><option>Pending</option><option>In Progress</option></select></label><label>Analyst<input asp-for="Item.Analyst" value="@User.Identity?.Name"/></label><label>Tools / software<input asp-for="Item.ToolsUsed" placeholder="Autopsy, FTK Imager, Magnet AXIOM"/></label><label class="wide-label">Notes<textarea asp-for="Item.Notes" rows="4" placeholder="Scope, acquisition notes, examination plan..."></textarea></label></div><button class="primary">Start examination →</button></form>
