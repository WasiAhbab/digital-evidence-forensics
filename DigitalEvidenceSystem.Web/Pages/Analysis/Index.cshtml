@page
@model DigitalEvidenceSystem.Web.Pages.Analysis.IndexModel
@{ViewData["Title"]="Forensic Analysis";}
<header class="page-head"><div><span class="eyebrow">FORENSIC WORKBENCH</span><h1>Forensic analysis</h1><p>Assign evidence, record examination work, findings and report references.</p></div><a class="primary link-button" asp-page="Create">+ Start analysis</a></header>
<form class="toolbar" method="get"><input name="q" value="@Model.Query" placeholder="Search evidence or analyst"/><select name="status"><option value="">All statuses</option>@foreach(var s in Model.Statuses){<option value="@s" selected="@(Model.Status==s)">@s</option>}</select><button class="secondary">Filter</button></form>
<section class="panel table-panel"><table><thead><tr><th>Evidence</th><th>Analyst</th><th>Tools</th><th>Status</th><th>Updated</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><b>@item.EvidenceItem?.EvidenceNumber</b><small>@item.EvidenceItem?.Name · @item.EvidenceItem?.CaseFile?.CaseNumber</small></td><td>@item.Analyst</td><td>@(string.IsNullOrWhiteSpace(item.ToolsUsed)?"—":item.ToolsUsed)</td><td><span class="status status-@item.Status.ToLower().Replace(" ","-")">@item.Status</span></td><td>@item.UpdatedAt.ToString("dd MMM yyyy, HH:mm")</td><td class="action-stack"><a class="text-link" asp-page="Edit" asp-route-id="@item.Id">Open</a><form method="post" asp-page-handler="Status"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="status" value="@(item.Status=="Pending"?"In Progress":item.Status=="In Progress"?"Completed":"Reviewed")"/><button class="table-action">@(item.Status=="Pending"?"Start":item.Status=="In Progress"?"Complete":item.Status=="Completed"?"Review":"Reviewed")</button></form></td></tr>}</tbody></table>@if(!Model.Items.Any()){<p class="empty">No analysis records match this filter.</p>}</section>
