@page
@model DigitalEvidenceSystem.Web.Pages.Reports.IndexModel
@{ViewData["Title"]="Reports";}
<header class="page-head"><div><span class="eyebrow">PROFESSIONAL REPORTING</span><h1>Reports</h1><p>Export operational registers and print a clean report view for case files.</p></div><button class="secondary" type="button" onclick="window.print()">Print report</button></header>
<section class="metrics report-metrics"><div class="metric"><span class="icon">▣</span><div><small>Evidence records</small><b>@Model.EvidenceCount</b><em>inventory</em></div></div><div class="metric"><span class="icon blue">▤</span><div><small>Cases</small><b>@Model.CaseCount</b><em>investigations</em></div></div><div class="metric"><span class="icon green">⇄</span><div><small>Transfers</small><b>@Model.TransferCount</b><em>custody events</em></div></div><div class="metric"><span class="icon orange">⌕</span><div><small>Analyses</small><b>@Model.AnalysisCount</b><em>examinations</em></div></div></section>
<div class="report-cards"><a class="report-card" asp-page-handler="EvidenceCsv"><span>▣</span><b>Evidence inventory</b><small>CSV with case, custodian, storage, integrity and hash fields.</small><strong>Export →</strong></a><a class="report-card" asp-page-handler="CustodyCsv"><span>⇄</span><b>Chain of custody</b><small>Chronological transfer register with condition and authorization.</small><strong>Export →</strong></a><a class="report-card" asp-page-handler="AuditCsv"><span>⌁</span><b>Audit history</b><small>Actor, action, entity, timestamp, details and IP metadata.</small><strong>Export →</strong></a></div>
<section class="panel table-panel"><div class="panel-head padded"><div><h2>Recent audit activity</h2><p>System actions shown in chronological order.</p></div><a class="text-link" asp-page="/Audit/Index">Full audit log</a></div><table><thead><tr><th>When</th><th>Actor</th><th>Action</th><th>Details</th></tr></thead><tbody>@foreach(var item in Model.AuditLogs){<tr><td>@item.OccurredAt.ToString("dd MMM yyyy, HH:mm")</td><td>@item.Actor</td><td><span class="badge">@item.Action</span></td><td>@item.Details</td></tr>}</tbody></table></section>
