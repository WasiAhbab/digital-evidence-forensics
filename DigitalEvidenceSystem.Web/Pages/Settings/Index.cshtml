@page
@model DigitalEvidenceSystem.Web.Pages.Settings.IndexModel
@{ViewData["Title"]="Settings";}
<header class="page-head"><div><span class="eyebrow">WORKSPACE SETTINGS</span><h1>Settings</h1><p>Manage your profile and review workspace health at a glance.</p></div></header>
<div class="settings-grid"><form method="post" class="panel form-panel"><div class="panel-head"><div><h2>Your profile</h2><p>Keep investigator identity information current.</p></div></div><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid single"><label>Full name<input asp-for="Input.FullName"/></label><label>Email<input asp-for="Input.Email" type="email"/></label><label>Department<input asp-for="Input.Department"/></label></div><button class="primary">Save profile</button></form><section class="panel"><div class="panel-head"><div><h2>System overview</h2><p>Current records in the workspace.</p></div></div><div class="mini-stats"><div><b>@Model.Users</b><small>Users</small></div><div><b>@Model.Cases</b><small>Cases</small></div><div><b>@Model.Evidence</b><small>Evidence</small></div><div><b>@Model.Analyses</b><small>Analyses</small></div></div><div class="security-note"><strong>Security posture</strong><p>Cookie authentication, hashed passwords, audit logging, role checks and protected file references are enabled.</p></div></section></div>
