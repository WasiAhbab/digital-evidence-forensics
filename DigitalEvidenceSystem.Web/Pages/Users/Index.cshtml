@page
@model DigitalEvidenceSystem.Web.Pages.Users.IndexModel
@using DigitalEvidenceSystem.Web.Models
@{ViewData["Title"]="Users";}
<header class="page-head"><div><span class="eyebrow">ADMINISTRATION</span><h1>User management</h1><p>Manage identities, roles and access to the evidence workspace.</p></div></header>
<div class="admin-grid"><form method="post" asp-page-handler="Create" class="panel"><div class="panel-head"><div><h2>Create user</h2><p>Passwords are stored only as hashes.</p></div></div><div class="form-grid single"><label>Full name<input asp-for="Input.FullName" required/></label><label>Username<input asp-for="Input.Username" required autocomplete="off"/></label><label>Password<input asp-for="Password" type="password" minlength="8" required autocomplete="new-password"/></label><label>Role<select asp-for="Input.Role">@foreach(var role in Roles.All){<option>@role</option>}</select></label><label>Email<input asp-for="Input.Email" type="email"/></label><label>Department<input asp-for="Input.Department"/></label></div><div asp-validation-summary="ModelOnly" class="validation"></div><button class="primary">Create user</button></form>
<section class="panel table-panel"><div class="panel-head padded"><div><h2>Accounts</h2><p>Use inactive status to revoke access without deleting the audit identity.</p></div></div><table><thead><tr><th>User</th><th>Role</th><th>Status</th><th>Last login</th><th></th></tr></thead><tbody>@foreach(var u in Model.Items){<tr><td><b>@u.FullName</b><small>@@@u.Username · @u.Department</small></td><td><form method="post" asp-page-handler="Role" class="role-form"><input type="hidden" name="id" value="@u.Id"/><select name="role" onchange="this.form.submit()">@foreach(var role in Roles.All){<option selected="@(u.Role==role)" value="@role">@role</option>}</select></form></td><td><span class="status @(u.IsActive?"status-completed":"status-closed")">@(u.IsActive?"Active":"Inactive")</span></td><td>@(u.LastLoginAt?.ToString("dd MMM yyyy, HH:mm")??"Never")</td><td><form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@u.Id"/><button class="table-action">@(u.IsActive?"Disable":"Enable")</button></form></td></tr>}</tbody></table></section></div>
