@page
@model DigitalEvidenceSystem.Web.Pages.Cases.CreateModel
@{ViewData["Title"]="New case";}
<header class="page-head"><div><span class="eyebrow">CASE MANAGEMENT</span><h1>Open a new case</h1><p>Create a clean record for the investigation.</p></div><a class="secondary link-button" asp-page="Index">Cancel</a></header><form method="post" class="panel form-panel"><div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><label>Case number<input asp-for="Item.CaseNumber" placeholder="CF-2026-004"/></label><label>Case title<input asp-for="Item.Title" placeholder="e.g. Unauthorized account access"/></label><label>Case type<select asp-for="Item.CaseType"><option>Cybercrime</option><option>Device Examination</option><option>Incident Response</option><option>Fraud</option><option>Other</option></select></label><label>Investigator<input asp-for="Item.Investigator" value="@User.Identity?.Name"/></label><label>Opened on<input asp-for="Item.OpenedOn" type="date"/></label><label>Priority<select asp-for="Item.Priority"><option>Low</option><option>Medium</option><option>High</option></select></label><label>Status<select asp-for="Item.Status"><option>Open</option><option>In Progress</option><option>Pending Review</option><option>Closed</option></select></label><label class="wide-label">Description<textarea asp-for="Item.Description" rows="4"></textarea></label></div><button class="primary">Create case →</button></form>
