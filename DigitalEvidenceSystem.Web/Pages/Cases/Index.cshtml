@page
@model DigitalEvidenceSystem.Web.Pages.Cases.IndexModel
@{ViewData["Title"]="Cases";}
<header class="page-head"><div><span class="eyebrow">CASE MANAGEMENT</span><h1>Cases</h1><p>Keep each investigation organized and moving forward.</p></div><a class="primary link-button" asp-page="Create">+ New case</a></header><form class="toolbar" method="get"><input name="q" value="@Model.Query" placeholder="Search case number or title"/><select name="status"><option value="">All statuses</option>@foreach(var s in Model.Statuses){<option selected="@(Model.Status==s)" value="@s">@s</option>}</select><button class="secondary">Filter</button></form><section class="panel table-panel"><table><thead><tr><th>Case</th><th>Investigator</th><th>Opened</th><th>Priority</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><b>@item.CaseNumber</b><small>@item.Title</small></td><td>@item.Investigator</td><td>@item.OpenedOn.ToString("dd MMM yyyy")</td><td><span class="priority @item.Priority.ToLower()">@item.Priority</span></td><td><span class="badge">@item.Status</span></td><td class="action-stack"><a class="text-link" asp-page="Details" asp-route-id="@item.Id">Open</a><a class="table-action" asp-page="Edit" asp-route-id="@item.Id">Edit</a></td></tr>}</tbody></table>@if(!Model.Items.Any()){<p class="empty">No cases match this filter.</p>}</section>
