@page "{id:int}"
@model DigitalEvidenceSystem.Web.Pages.Cases.DetailsModel
@{ViewData["Title"]="Case details";}
<header class="page-head"><div><span class="eyebrow">CASE FILE · @Model.Item.CaseNumber</span><h1>@Model.Item.Title</h1><p>@Model.Item.Description</p></div><div class="head-actions"><a class="secondary link-button" asp-page="Index">Back</a><a class="primary link-button" asp-page="Edit" asp-route-id="@Model.Item.Id">Edit case</a></div></header>
<section class="case-summary"><div><small>Status</small><strong>@Model.Item.Status</strong></div><div><small>Priority</small><strong class="priority @Model.Item.Priority.ToLower()">@Model.Item.Priority</strong></div><div><small>Investigator</small><strong>@Model.Item.Investigator</strong></div><div><small>Opened</small><strong>@Model.Item.OpenedOn.ToString("dd MMM yyyy")</strong></div><div><small>Updated</small><strong>@Model.Item.UpdatedAt.ToString("dd MMM yyyy, HH:mm")</strong></div></section>
<div class="case-grid"><section class="panel"><div class="panel-head"><div><h2>Evidence inventory</h2><p>@Model.Evidence.Count item(s) linked to this case.</p></div><a class="text-link" asp-page="/Evidence/Create">+ Add</a></div>@foreach(var e in Model.Evidence){<div class="case-detail-row"><div><b>@e.EvidenceNumber · @e.Name</b><small>@e.Type · @e.CurrentCustodian</small></div><span class="badge">@e.Status</span><a class="text-link" asp-page="/Evidence/Edit" asp-route-id="@e.Id">Open</a></div>}@if(!Model.Evidence.Any()){<p class="empty">No evidence is linked yet.</p>}</section>
<section class="panel"><div class="panel-head"><div><h2>Case notes</h2><p>Chronological working notes with author attribution.</p></div></div><form method="post" asp-page-handler="Note" class="inline-form"><textarea name="Note" rows="3" placeholder="Add an investigation note..."></textarea><button class="primary">Add note</button></form>@foreach(var n in Model.Notes){<div class="note"><b>@n.Author</b><small>@n.CreatedAt.ToString("dd MMM yyyy, HH:mm")</small><p>@n.Note</p></div>}</section>
<section class="panel"><div class="panel-head"><div><h2>Persons / entities</h2><p>Suspects, victims and relevant persons.</p></div></div><form method="post" asp-page-handler="Person" class="form-grid compact"><label>Name<input name="PersonName"/></label><label>Relationship<select name="Relationship"><option>Suspect</option><option>Victim</option><option>Witness</option><option>Relevant Person</option></select></label><label class="wide-label">Notes<input name="PersonNotes"/></label><button class="primary">Add person</button></form>@foreach(var p in Model.People){<div class="person-row"><b>@p.Name</b><span class="badge">@p.Relationship</span><small>@p.Notes</small></div>}</section></div>
