@page "{id:int}"
@model DigitalEvidenceSystem.Web.Pages.Cases.EditModel
@{ViewData["Title"]="Edit case";}
<header class="page-head"><div><span class="eyebrow">CASE MANAGEMENT</span><h1>Edit @Model.Item.CaseNumber</h1><p>Update this investigation’s current details.</p></div><a class="secondary link-button" asp-page="Index">Back to cases</a></header><form method="post" class="panel form-panel"><input asp-for="Item.Id" type="hidden"/><div class="form-grid"><label>Case number<input asp-for="Item.CaseNumber" readonly/></label><label>Case title<input asp-for="Item.Title"/></label><label>Case type<select asp-for="Item.CaseType"><option>Cybercrime</option><option>Device Examination</option><option>Incident Response</option><option>Fraud</option><option>Other</option></select></label><label>Investigator<input asp-for="Item.Investigator"/></label><label>Opened on<input asp-for="Item.OpenedOn" type="date"/></label><label>Priority<select asp-for="Item.Priority"><option>Low</option><option>Medium</option><option>High</option></select></label><label>Status<select asp-for="Item.Status"><option>Open</option><option>In Progress</option><option>Pending Review</option><option>Closed</option></select></label><label class="wide-label">Description<textarea asp-for="Item.Description" rows="4"></textarea></label></div><button class="primary">Save changes →</button></form>
